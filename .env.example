# ==============================================================================
# XEROX CYBERSECURITY ANALYST PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit .env to version control.

# Application Settings
PROJECT_NAME="XEROX"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS Settings (JSON list of origins or comma-separated strings)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Security & Authentication
# Generate a strong 256-bit secret key in production (e.g. openssl rand -hex 32)
SECRET_KEY="xerox_development_secret_key_change_in_production_32_chars_min"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in production, SQLite fallback in local dev)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/xerox"
# Fallback dev database URL if PostgreSQL is unavailable locally:
# DATABASE_URL="sqlite+aiosqlite:///./xerox.db"

# Cache Configuration (Redis in production, in-memory fallback in local dev)
REDIS_URL="redis://localhost:6379/0"
CACHE_TTL_SECONDS=86400

# Threat Intelligence Providers
VIRUSTOTAL_API_KEY=""

# AI Explanation Provider (Google Gemini)
GEMINI_API_KEY=""

# Audit Logging & Workers
ASYNC_AUDIT_LOGGING=True
MAX_WORKERS=4
